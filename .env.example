# Local MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=mahakumbh_stays_db
MYSQL_USER=
MYSQL_PASSWORD=

# Razorpay test/live keys and the dedicated webhook secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Confirmation and cancellation email
SMTP_URL=
SMTP_FROM=

# Optional production infrastructure. The application remains stateless without these,
# using the database queue and bounded in-process cache for local development.
REDIS_URL=
QUEUE_CONCURRENCY=4
LOG_LEVEL=info
TRUST_PROXY=false

# Optional approved map provider. Leave empty to show the honest unavailable/fallback state.
GOOGLE_MAPS_BROWSER_KEY=

# Public deployment settings. Use HTTPS and a matching origin in production.
# NODE_ENV=production
# APP_ORIGIN=https://stays.example.com
# SITE_ORIGIN=https://stays.example.com
# HOST=0.0.0.0

# Set locally for the one-time npm run admin:create command, then remove.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
